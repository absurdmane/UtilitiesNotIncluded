<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Unity 6 Mono exposes the .NET Standard 2.1 API surface; net6.0 assemblies don't load there. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>UtilitiesNotIncluded</AssemblyName>
    <RootNamespace>UtilitiesNotIncluded</RootNamespace>
    <Description>Appliances, lights and taps depend on the building's real utility upgrades (Obenseuer, BepInEx 6, Unity Mono)</Description>
    <Authors>absurdmane</Authors>
    <Company>absurdmane</Company>
    <Product>UtilitiesNotIncluded</Product>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>embedded</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- GameDir comes from ../local.props (see local.props.example). dotnet build -p:Deploy=true copies the dll into BepInEx\plugins\UtilitiesNotIncluded,
         -p:Deploy=scripts into BepInEx\scripts\UtilitiesNotIncluded -->
    <Deploy Condition="'$(Deploy)' == ''">false</Deploy>
  </PropertyGroup>

  <ItemGroup>
    <!-- Makes private game members visible at compile time (Mono doesn't enforce access checks). -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.Mono.dll" Private="false" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />

    <Reference Include="$(ManagedDir)\Assembly-CSharp.dll" Publicize="true" Private="false" />
    <Reference Include="$(ManagedDir)\Assembly-CSharp-firstpass.dll" Publicize="true" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Delete Files="$(GameDir)\BepInEx\scripts\UtilitiesNotIncluded\UtilitiesNotIncluded.dll;$(GameDir)\BepInEx\scripts\UtilitiesNotIncluded\UtilitiesNotIncluded.pdb" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\UtilitiesNotIncluded" />
    <Message Importance="high" Text="UtilitiesNotIncluded -> $(GameDir)\BepInEx\plugins\UtilitiesNotIncluded" />
  </Target>
  <Target Name="DeployToScripts" AfterTargets="Build" Condition="'$(Deploy)' == 'scripts'">
    <Delete Files="$(GameDir)\BepInEx\plugins\UtilitiesNotIncluded\UtilitiesNotIncluded.dll" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\scripts\UtilitiesNotIncluded" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(GameDir)\BepInEx\scripts\UtilitiesNotIncluded" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Message Importance="high" Text="UtilitiesNotIncluded -> $(GameDir)\BepInEx\scripts\UtilitiesNotIncluded (press the reload key in game)" />
  </Target>

</Project>
